{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  labels: [
    'dependencies',
  ],
  timezone: 'America/Los_Angeles',
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  prCreation: 'not-pending',
  // CI runs on PRs only, so passing stability-days is the branch's sole check. Count it as green so
  // PRs open once minimumReleaseAge passes; the ruleset's required Validate check gates merges.
  internalChecksAsSuccess: true,
  automergeType: 'pr',
  automergeStrategy: 'squash',
  platformAutomerge: false,
  // Merge green PRs even when behind main; otherwise each run rebases instead of merging.
  rebaseWhen: 'conflicted',
  automergeSchedule: [
    '* 8-11 * * 1-5',
  ],
  // Keep in sync with nix/packages/gh-actions-lock.nix.
  constraints: {
    ghActionsLock: 'v0.4.1',
  },
  lockFileMaintenance: {
    enabled: true,
  },
  nix: {
    enabled: true,
  },
  "pre-commit": {
    enabled: true,
  },
  kubernetes: {
    enabled: true,
    // Only files with apiVersion/kind and image: lines yield dependencies.
    managerFilePatterns: [
      '/^kube/.+\\.ya?ml$/',
    ],
  },
  packageRules: [
    {
      matchUpdateTypes: ['digest', 'pin', 'pinDigest', 'patch'],
      automerge: true,
    },
    {
      matchManagers: ['github-actions', 'pre-commit'],
      matchUpdateTypes: ['minor'],
      automerge: true,
    },
    {
      matchUpdateTypes: ['lockFileMaintenance'],
      automerge: true,
    },
    {
      matchPackageNames: [
        'argo-cd',
        'quay.io/argoproj/argocd',
        'traefik',
        'metallb',
        'longhorn',
        'kube-prometheus-stack',
        'cloudnative-pg',
        'plugin-barman-cloud',
        // Digest bumps restart the database pods.
        'ghcr.io/cloudnative-pg/postgresql',
      ],
      automerge: false,
    },
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
    // The chart's appVersion is the matching server release; bump them together.
    {
      matchFileNames: ['kube/nuc01/fleet-apps/fleet.yaml', 'kube/nuc01/fleet/values.yaml'],
      groupName: 'fleet',
      groupSlug: 'fleet',
    },
    // Own artifacts: ship as soon as they are published. Digests and OCI charts carry no release
    // timestamp, so minimumReleaseAge would hold them forever. Branch pushes run no CI (validate
    // is pull_request only), so prCreation 'not-pending' would hold the PR for prNotPendingHours.
    {
      matchPackageNames: ['ghcr.io/charg/bitmagnet', 'ghcr.io/charg/website', 'ghcr.io/charg/charts/**', 'ghcr.io/charg/containers/**'],
      minimumReleaseAge: null,
      prCreation: 'immediate',
      automergeSchedule: ['at any time'],
    },
    {
      matchPackageNames: ['ghcr.io/charg/bitmagnet', 'ghcr.io/charg/website'],
      matchUpdateTypes: ['digest'],
      automerge: true,
    },
    // Argo CD's targetRevision takes a chart version, not a digest.
    {
      matchDepTypes: ['oci-chart'],
      pinDigests: false,
    },
    {
      matchPackageNames: ['ghcr.io/charg/charts/**'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^kube/[^/]+/app-of-apps/application_set_apps\\.yaml$/',
        '/^kube/[^/]+/fleet-apps/fleet\\.yaml$/',
      ],
      matchStrings: [
        'repoURL:\\s*(?<registryUrl>https?://\\S+)\\s*\\n\\s*chart:\\s*(?<packageName>\\S+)\\s*\\n\\s*targetRevision:\\s*(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'helm',
      versioningTemplate: 'helm',
    },
    // OCI charts. Argo CD writes OCI repoURLs without a scheme, so the https helm manager above
    // skips them.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^kube/[^/]+/app-of-apps/application_[^/]+\\.yaml$/',
      ],
      matchStrings: [
        'repoURL:\\s*(?<namespace>[a-z0-9.-]+\\.[a-z]{2,}/[^\\s:]+)\\s*\\n\\s*chart:\\s*(?<packageName>\\S+)\\s*\\n\\s*targetRevision:\\s*(?<currentValue>\\d\\S*)',
      ],
      datasourceTemplate: 'docker',
      packageNameTemplate: '{{namespace}}/{{packageName}}',
      versioningTemplate: 'semver',
      depTypeTemplate: 'oci-chart',
    },
    // Git-sourced Applications pinned to a tag.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^kube/[^/]+/app-of-apps/application_[^/]+\\.yaml$/',
      ],
      matchStrings: [
        'repoURL:\\s*https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+?)(?:\\.git)?\\s*\\n(?:\\s*path:.*\\n)?\\s*targetRevision:\\s*(?<currentValue>v?\\d\\S*)',
      ],
      datasourceTemplate: 'github-tags',
    },
    // Image as repository/tag/digest helm values.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^kube/[^/]+/app-of-apps/application_[^/]+\\.yaml$/',
      ],
      matchStrings: [
        'repository:\\s*(?<depName>\\S+)\\s*\\n\\s*tag:\\s*(?<currentValue>[^\\s@]+)\\s*\\n\\s*digest:\\s*(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
    },
    // CloudNativePG Cluster images.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^kube/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'imageName:\\s*(?<depName>[^\\s:@]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      datasourceTemplate: 'docker',
    },
    // Fleet chart's server image tag.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^kube/[^/]+/fleet/values\\.yaml$/',
      ],
      matchStrings: [
        'imageTag:\\s*(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      depNameTemplate: 'fleetdm/fleet',
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^kube/[^/]+/plex/values\\.yaml$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*tag:\\s*[\'"]?(?<currentValue>[^\'"\\s]+)[\'"]?\\s*\\n\\s*sha:\\s*[\'"]?(?<currentDigest>[^\'"\\s]+)[\'"]?',
      ],
    },
  ],
}
