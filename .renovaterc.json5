{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  labels: [
    'dependencies',
  ],
  timezone: 'America/Los_Angeles',
  // Monday-only branch creation
  schedule: [
    '* * * * 1',
  ],
  lockFileMaintenance: {
    enabled: true,
  },
  nix: {
    enabled: true,
  },
  "pre-commit": {
    enabled: true,
  },
  kubernetes: {
    enabled: true,
    managerFilePatterns: [
      '/^kube/lookie/prowlarr/deployment\\.yaml$/',
      '/^kube/lookie/qbit-neo/statefulset\\.yaml$/',
      '/^kube/lookie/scryer/deployment\\.yaml$/',
      '/^kube/lookie/trawl/deployment\\.yaml$/',
      '/^kube/nuc01/ac-redis/redis\\.yaml$/',
      '/^kube/nuc01/ov-redis/redis\\.yaml$/',
      '/^kube/nuc01/ac-rustfs/deployment\\.yaml$/',
      '/^kube/nuc01/ac-rustfs/create-bucket-job\\.yaml$/',
      '/^kube/nuc01/ov-rustfs/deployment\\.yaml$/',
      '/^kube/nuc01/ov-rustfs/proxy-deployment\\.yaml$/',
      '/^kube/nuc01/ov-rustfs/create-bucket-job\\.yaml$/',
      '/^kube/nuc01/cloudflared/deployment\\.yaml$/',
    ],
  },
  packageRules: [
    {
      matchFileNames: ['nix/programs/litellm/docker-compose.yaml'],
      pinDigests: true,
      groupName: 'litellm compose images',
      groupSlug: 'litellm-compose',
    },
    {
      matchFileNames: ['kube/nuc01/app-of-apps/application_set_apps.yaml'],
      groupName: 'nuc01 cluster updates',
      groupSlug: 'nuc01-cluster',
    },
    {
      matchFileNames: ['kube/lookie/app-of-apps/application_set_apps.yaml'],
      groupName: 'lookie cluster updates',
      groupSlug: 'lookie-cluster',
    },
    {
      matchPackageNames: [
        'plexinc/pms-docker',
        'ghcr.io/qdm12/gluetun',
        'ghcr.io/home-operations/qbittorrent',
      ],
      schedule: ['at any time'],
    },
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^kube/[^/]+/app-of-apps/application_set_apps\\.yaml$/',
      ],
      matchStrings: [
        'name:\\s*node-feature-discovery[\\s\\S]*?repoURL:\\s*oci://(?<namespace>\\S+)\\s*\\n\\s*chart:\\s*(?<packageName>node-feature-discovery)\\s*\\n\\s*targetRevision:\\s*(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'docker',
      packageNameTemplate: '{{namespace}}/{{packageName}}',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^kube/[^/]+/app-of-apps/application_set_apps\\.yaml$/',
      ],
      matchStrings: [
        'repoURL:\\s*(?<registryUrl>https?://\\S+)\\s*\\n\\s*chart:\\s*(?<packageName>\\S+)\\s*\\n\\s*targetRevision:\\s*(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'helm',
      versioningTemplate: 'helm',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^kube/[^/]+/plex/values\\.yaml$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*tag:\\s*[\'"]?(?<currentValue>[^\'"\\s]+)[\'"]?\\s*\\n\\s*sha:\\s*[\'"]?(?<currentDigest>[^\'"\\s]+)[\'"]?',
      ],
    },
  ],
}
