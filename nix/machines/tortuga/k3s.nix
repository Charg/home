{
  config,
  lib,
  pkgs,
  ...
}:

let
  nodeName = config.networking.hostName;
  nodeIP = (import ../../common/k3s-agents.nix).${nodeName};
  serverNodes = import ../../common/k3s-nodes.nix;
  servers = lib.attrValues serverNodes;

  nvidiaToolkit = lib.getOutput "tools" config.hardware.nvidia-container-toolkit.package;

  # On-demand switch for the GPU node: `gpu-node on|off|status`.
  gpu-node = pkgs.writeShellApplication {
    name = "gpu-node";
    runtimeInputs = with pkgs; [
      kubectl
      iproute2
      systemd
    ];
    text = ''
      node=${nodeName}

      case "''${1:-status}" in
        on)
          # The node is pinned to this address; joining from any other one
          # breaks flannel for every pod scheduled here.
          if ! ip -4 -o addr show | grep -q " ${nodeIP}/"; then
            echo "error: ${nodeIP} is not assigned to this host; renew the DHCP lease first" >&2
            exit 1
          fi
          sudo systemctl start k3s
          echo "waiting for $node to register..."
          timeout 300 sh -c "until kubectl get node $node >/dev/null 2>&1; do sleep 2; done"
          kubectl wait --for=condition=Ready "node/$node" --timeout=5m
          kubectl uncordon "$node"
          ;;
        off)
          if systemctl is-active --quiet k3s; then
            # GPU pods have nowhere else to go, so they sit Pending until the
            # node returns.
            kubectl drain "$node" --ignore-daemonsets --delete-emptydir-data --timeout=2m
          fi
          # Stopping k3s leaves its containers running (KillMode=process);
          # killall stops the unit and kills them, freeing the VRAM.
          sudo ${config.services.k3s.package}/bin/k3s-killall.sh >/dev/null 2>&1
          echo "$node is off"
          ;;
        status)
          echo "k3s: $(systemctl is-active k3s || true)"
          kubectl get node "$node" 2>/dev/null || true
          nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv
          ;;
        *)
          echo "usage: gpu-node on|off|status" >&2
          exit 1
          ;;
      esac
    '';
  };
in
{
  #
  # k3s agent, joined to the nuc01 cluster on demand
  #
  # Not started at boot; `gpu-node on` / `gpu-node off` hand the GPU between
  # the cluster and the desktop. The taint keeps everything but GPU workloads
  # off this node.
  services.k3s = {
    enable = true;
    role = "agent";
    serverAddr = "https://${serverNodes.nuc01}:6443";
    tokenFile = "/etc/rancher/k3s/token";
    inherit nodeIP;
    nodeLabel = [
      # Matches the nvidia-device-plugin chart's default node affinity.
      "nvidia.com/gpu.present=true"
      "home.packet.fail/on-demand=true"
    ];
    nodeTaint = [ "nvidia.com/gpu=true:NoSchedule" ];
  };

  systemd.services.k3s = {
    wantedBy = lib.mkForce [ ];
    # k3s registers a containerd runtime for each nvidia-container-runtime
    # binary it finds on PATH (the `nvidia` RuntimeClass).
    path = [ nvidiaToolkit ];
  };

  # CDI mode injects the spec generated by hardware.nvidia-container-toolkit;
  # the legacy mode relies on an ldcache NixOS doesn't have.
  # NVIDIA_VISIBLE_DEVICES=0 from the device plugin resolves to nvidia.com/gpu=0.
  environment.etc."nvidia-container-runtime/config.toml".text = ''
    [nvidia-container-runtime]
    mode = "cdi"
    runtimes = ["runc"]
  '';

  # kubelet API (apiserver, Prometheus) and flannel VXLAN, from the servers only.
  networking.firewall.extraCommands =
    lib.concatMapStringsSep "\n" (server: ''
      iptables -w -A nixos-fw -p tcp -s ${server} --dport 10250 -j nixos-fw-accept
      iptables -w -A nixos-fw -p udp -s ${server} --dport 8472 -j nixos-fw-accept
    '') servers
    + "\n";

  networking.networkmanager.unmanaged = [
    "interface-name:cni*"
    "interface-name:flannel*"
  ];

  # Model store for kube/nuc01/llama-swap (hostPath). Owned by the pod's UID;
  # lives outside k3s' data so `k3s-killall.sh` and PVC deletion can't touch it.
  systemd.tmpfiles.rules = [
    "d /var/lib/llama-swap 0755 root root -"
    "d /var/lib/llama-swap/models 0750 10001 10001 -"
  ];

  environment.systemPackages = [ gpu-node ];
}
